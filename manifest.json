{
  "manifest_version": 3,
  "name": "QuickReply Shortcuts",
  "version": "1.0.0",
  "description": "Expand shortcuts like #followup into full replies in Gmail.",
  "action": {
    "default_title": "QuickReply Shortcuts"
  },
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
